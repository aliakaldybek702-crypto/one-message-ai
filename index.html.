
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ONE MESSAGE — AI Assistant</title>
<style>
:root {
  --wine:#701f32;
  --dark:#351018;
  --cream:#fff8f3;
  --pink:#f1dcd5;
  --muted:#856b68;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  color:var(--dark);
  background:var(--cream);
}
header{
  display:flex;justify-content:space-between;align-items:center;
  padding:22px 6%;border-bottom:1px solid #ead3cb;
  gap:20px;flex-wrap:wrap;
}
.logo{font-family:Georgia,serif;font-size:27px;color:var(--wine);font-weight:bold}
nav{display:flex;gap:25px;flex-wrap:wrap}
nav a{color:var(--dark);text-decoration:none;font-weight:600}
nav a:hover{color:var(--wine)}
.hero{
  padding:75px 7% 55px;
  background:radial-gradient(circle at 85% 20%,#e8bfc0,transparent 35%),
  linear-gradient(120deg,#fff8f3,#f3dfd8);
}
.tag{
  display:inline-block;background:#ead0c9;color:var(--wine);
  border-radius:30px;padding:10px 18px;font-weight:bold;
}
h1{
  font-family:Georgia,serif;font-size:clamp(42px,7vw,76px);
  line-height:1.02;color:#46131f;max-width:850px;margin:25px 0;
}
.hero p{font-size:19px;line-height:1.6;max-width:650px}
.analyzer{
  margin-top:35px;max-width:850px;background:white;
  border:1px solid #e9d3cb;border-radius:20px;padding:12px;
  box-shadow:0 12px 35px #67263a18;
}
textarea{
  width:100%;min-height:115px;border:0;outline:0;resize:vertical;
  padding:14px;font:17px Arial;color:var(--dark);background:transparent;
}
.actions{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
button{
  border:0;border-radius:30px;padding:14px 25px;
  background:var(--wine);color:white;font-size:16px;
  font-weight:bold;cursor:pointer;
}
button:hover{background:#4c1423}
.hint{color:var(--muted);font-size:13px}
#result{
  display:none;max-width:850px;margin-top:25px;padding:25px;
  border-radius:20px;background:white;border:1px solid #ead5cd;
  line-height:1.65;
}
#result h2{color:var(--wine);margin-top:0}
.result-section{padding:12px 0;border-bottom:1px solid #f0e4df}
.features{padding:55px 6%}
.features h2{text-align:center;font: bold 36px Georgia;color:var(--wine)}
.cards{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:18px;margin-top:30px;
}
.card{
  background:white;border:1px solid #efdfd9;border-radius:20px;
  padding:25px;box-shadow:0 7px 20px #51202a0c;
}
.card .symbol{font-size:30px}
.card h3{color:var(--wine)}
.card p{line-height:1.5;color:var(--muted)}
.about{
  text-align:center;padding:45px 20px;background:#f1ded8;
}
.about h2{font:32px Georgia;color:var(--wine)}
footer{text-align:center;padding:25px;color:var(--muted)}
@media(max-width:600px){
 header{padding:18px 5%}
 nav{gap:14px;font-size:14px}
 .hero{padding:50px 6%}
 .hero p{font-size:16px}
}
</style>
</head>
<body>

<header>
  <div class="logo">✦ ONE MESSAGE</div>
  <nav>
    <a href="#home">Главная</a>
    <a href="#analysis">Анализ</a>
    <a href="#features">Возможности</a>
    <a href="#about">О проекте</a>
  </nav>
</header>

<section class="hero" id="home">
  <span class="tag">✦ Умный помощник</span>
  <h1>Одно сообщение — несколько смыслов</h1>
  <p>
    Введи любое слово, предложение или сообщение.
    Узнай его значение, эмоциональную окраску и возможный скрытый смысл.
  </p>

  <div class="analyzer" id="analysis">
    <textarea id="message" placeholder="Например: Хорошо. Или: Я совсем не злюсь!!!"></textarea>
    <div class="actions">
      <span class="hint">Можно написать слово или целое сообщение</span>
      <button onclick="analyze()">✦ Анализировать</button>
    </div>
  </div>

  <div id="result" aria-live="polite"></div>
</section>

<section class="features" id="features">
  <h2>Возможности помощника</h2>
  <div class="cards">
    <div class="card">
      <div class="symbol">📖</div>
      <h3>Значение слов</h3>
      <p>Объяснение слов, выражений и их употребления.</p>
    </div>
    <div class="card">
      <div class="symbol">♡</div>
      <h3>Анализ эмоций</h3>
      <p>Определение возможной эмоциональной окраски сообщения.</p>
    </div>
    <div class="card">
      <div class="symbol">⁉</div>
      <h3>Пунктуация</h3>
      <p>Как точки, многоточия и восклицательные знаки меняют восприятие.</p>
    </div>
    <div class="card">
      <div class="symbol">✎</div>
      <h3>Оформление</h3>
      <p>Анализ заглавных букв, повторов и эмодзи.</p>
    </div>
    <div class="card">
      <div class="symbol">⇄</div>
      <h3>Сравнение</h3>
      <p>Сравнение нескольких вариантов одного сообщения.</p>
    </div>
    <div class="card">
      <div class="symbol">☼</div>
      <h3>Контекст</h3>
      <p>Объяснение того, как ситуация общения влияет на смысл.</p>
    </div>
  </div>
</section>

<section class="about" id="about">
  <h2>Больше, чем просто слова</h2>
  <p>Исследуем, как цифровое общение передаёт эмоции и смыслы.</p>
</section>

<footer>ONE MESSAGE AI · 2026</footer>

<script>
function analyze(){
  const input=document.getElementById("message").value.trim();
  const result=document.getElementById("result");

  if(!input){
    alert("Сначала введи слово или сообщение.");
    return;
  }

  const dots=(input.match(/\./g)||[]).length;
  const exclamations=(input.match(/!/g)||[]).length;
  const questions=(input.match(/\?/g)||[]).length;
  const ellipsis=input.includes("...");
  const capitals=(input.match(/[А-ЯЁA-Z]/g)||[]).length;
  const emojis=/[\u{1F300}-\u{1FAFF}]/u.test(input);

  let punctuation="Особых пунктуационных сигналов не обнаружено.";
  if(ellipsis) punctuation="Многоточие может передавать паузу, сомнение или незавершённость мысли.";
  else if(exclamations>=2) punctuation="Несколько восклицательных знаков могут усиливать эмоциональность.";
  else if(dots>0) punctuation="Точка обозначает завершённость фразы. В переписке она иногда воспринимается как сдержанность.";
  else if(questions>0) punctuation="Вопросительный знак показывает вопрос или запрос реакции.";

  let style="Обычное графическое оформление.";
  if(capitals>=3) style="Заглавные буквы могут восприниматься как усиление интонации или акцент.";
  if(emojis) style+=" В сообщении присутствует эмодзи, который может дополнять эмоциональный смысл.";

  let emotion="Эмоцию нельзя достоверно определить только по тексту.";
  const lower=input.toLowerCase();
  if(/спасибо|ура|рад|рада|счаст|люблю|классно/.test(lower))
    emotion="Возможна положительная эмоциональная окраска.";
  else if(/злюсь|ненавиж|бесит|ужасно|надоело/.test(lower))
    emotion="Возможна отрицательная эмоциональная окраска.";
  else if(/груст|печаль|одинок|скучаю/.test(lower))
    emotion="Возможна грустная или печальная окраска.";

  result.style.display="block";
  result.innerHTML=`
    <h2>✦ Результат анализа</h2>
    <div class="result-section"><b>Исходное сообщение:</b><br>${escapeHTML(input)}</div>
    <div class="result-section"><b>Эмоциональная окраска:</b><br>${emotion}</div>
    <div class="result-section"><b>Пунктуация:</b><br>${punctuation}</div>
    <div class="result-section"><b>Графическое оформление:</b><br>${style}</div>
    <div class="result-section"><b>Общий вывод:</b><br>Восприятие сообщения зависит от слов, оформления, ситуации и отношений между собеседниками.</div>
    <p class="hint">Это демонстрационный анализ по простым правилам, а не полноценный ответ искусственного интеллекта.</p>
  `;
  result.scrollIntoView({behavior:"smooth",block:"nearest"});
}
function escapeHTML(text){
  return text.replace(/[&<>"']/g,function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
  });
}
</script>
</body>
</html>
